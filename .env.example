APP_NAME="FastAPI AI Chatbot"
APP_ENV="development"
DEBUG=True
PORT=8000
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000,http://localhost:5173,http://127.0.0.1:8000,http://127.0.0.1:3000"

# Internal Security (Opsional: Kosongkan jika tidak ingin proteksi API Key di endpoint)
INTERNAL_API_KEY="your-secret-internal-api-key-here"

# OpenAI Credentials
OPENAI_API_KEY="sk-your-openai-api-key-here"
OPENAI_ASSISTANT_ID="asst_your_assistant_id_here"
OPENAI_MODEL="gpt-4o-mini"
